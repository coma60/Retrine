+                                                 kCGBitmapByteOrder32Big | kCGImageAlphaPremultipliedLast);
+    CGColorSpaceRelease(space);
+    CGImageRef image = CGBitmapContextCreateImage(context);
+    CGContextRelease(context);
+    free(pixels);
+    return image;
+}
